{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Reeperk/Forge/main/crates/forge-jsonschema/schemas/minecraft-velocity-plugin.json",
  "title": "Velocity velocity-plugin.json",
  "type": "object",
  "required": [
    "id",
    "main"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-_]{0,63}$",
      "description": "The plugin id: lowercase letters, digits, '-' and '_', starting with a letter, at most 64 characters."
    },
    "name": {
      "type": "string",
      "description": "The plugin's display name."
    },
    "version": {
      "type": "string",
      "description": "The plugin's version."
    },
    "description": {
      "type": "string",
      "description": "A short description of what the plugin does."
    },
    "url": {
      "type": "string",
      "description": "The plugin's website."
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The plugin's authors."
    },
    "dependencies": {
      "type": "array",
      "description": "Plugins this plugin depends on.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the plugin depended on."
          },
          "optional": {
            "type": "boolean",
            "description": "The plugin also loads without the dependency."
          }
        }
      }
    },
    "main": {
      "type": "string",
      "pattern": "^([A-Za-z_$][A-Za-z0-9_$]*\\.)+[A-Za-z_$][A-Za-z0-9_$]*$",
      "description": "The fully qualified name of the plugin's main class."
    }
  }
}
