{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Reeperk/Forge/main/crates/forge-jsonschema/schemas/minecraft-bukkit-plugin.json",
  "title": "Bukkit / Spigot / Paper plugin.yml",
  "type": "object",
  "required": [
    "name",
    "version",
    "main"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 _.-]+$",
      "description": "The plugin's name: letters, digits, '_', '-' and '.'."
    },
    "version": {
      "type": [
        "string",
        "number"
      ],
      "description": "The plugin's version."
    },
    "main": {
      "type": "string",
      "pattern": "^([A-Za-z_$][A-Za-z0-9_$]*\\.)+[A-Za-z_$][A-Za-z0-9_$]*$",
      "description": "The fully qualified name of the plugin's main class."
    },
    "description": {
      "type": "string",
      "description": "A short description of what the plugin does."
    },
    "api-version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "The Minecraft API version the plugin is written for, e.g. 1.21. Without it Spigot / Paper treat the plugin as legacy (pre-1.13)."
    },
    "load": {
      "type": "string",
      "enum": [
        "STARTUP",
        "POSTWORLD"
      ],
      "description": "When the plugin loads: STARTUP (before the worlds) or POSTWORLD (the default, after them)."
    },
    "author": {
      "type": "string",
      "description": "The plugin's author."
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The plugin's authors."
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Contributors besides the authors."
    },
    "website": {
      "type": "string",
      "description": "The plugin's or author's website."
    },
    "prefix": {
      "type": "string",
      "description": "The name the plugin's logger uses instead of its name."
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other plugin names this plugin provides (for dependencies)."
    },
    "folia-supported": {
      "type": "boolean",
      "description": "The plugin supports Folia's regionized multithreading (Folia refuses plugins without it)."
    },
    "permissions": {
      "type": "object",
      "description": "Permissions the plugin defines.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "What the permission allows."
          },
          "default": {
            "description": "Who has the permission by default.",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false",
                  "op",
                  "not op",
                  "!op",
                  "notop",
                  "isop",
                  "admin",
                  "!admin",
                  "noop"
                ]
              }
            ]
          },
          "children": {
            "description": "Child permissions: true grants, false revokes them with this one.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "depend": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plugins that must load before this one; the plugin does not load without them."
    },
    "softdepend": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plugins that load before this one when they are installed."
    },
    "loadbefore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plugins that load after this one."
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^:\\s]+:[^:\\s]+:[^:\\s]+$"
      },
      "description": "Maven Central libraries the server downloads and adds to the plugin's class path (group:artifact:version)."
    },
    "default-permission": {
      "description": "Who has the permission by default.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "false",
            "op",
            "not op",
            "!op",
            "notop",
            "isop",
            "admin",
            "!admin",
            "noop"
          ]
        }
      ]
    },
    "paper-plugin-loader": {
      "type": "string",
      "description": "Paper: a PluginLoader class that adds libraries to the class path."
    },
    "paper-skip-libraries": {
      "type": "boolean",
      "description": "Paper: do not download the libraries (the plugin loader does)."
    },
    "commands": {
      "type": "object",
      "description": "The plugin's commands.",
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "What the command does (shown in /help)."
          },
          "aliases": {
            "description": "Other names of the command.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "permission": {
            "type": "string",
            "description": "The permission needed to run the command."
          },
          "permission-message": {
            "type": "string",
            "description": "The message players without the permission get."
          },
          "usage": {
            "type": "string",
            "description": "How to use the command; <command> is replaced with its name."
          }
        }
      }
    }
  }
}
