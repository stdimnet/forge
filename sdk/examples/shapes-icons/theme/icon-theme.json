  "file": "file",
  "folder": "folder",
  "folderExpanded": "folder-open",
  "rootFolder": "folder-root",
  "rootFolderExpanded": "folder-root-open",
  "folderHollow": "folder-hollow",
  "folderHollowExpanded": "folder-hollow-open",
  "fileNames": {
    "composer.json": "composer",
    "composer.lock": "lock",
    "package-lock.json": "lock",
    "pnpm-lock.yaml": "lock"
  },
  "fileExtensions": {
    "php": "php",
    "blade.php": "blade",
    "js": "js",
    "mjs": "js",
    "ts": "ts",
    "json": "json",
    "md": "markdown",
    "css": "css",
    "scss": "css",
    "html": "html",
    "yml": "yaml",
    "yaml": "yaml",
    "lock": "lock",
    "sh": "shell"
  },
  "fileTypes": {
    "shell": "shell",
    "php": "php"
  },
  "pathRules": [
    { "pattern": "Controllers/*.php", "icon": "controller" }
  ],
  "filePatterns": [
    { "pattern": "*Test.php", "icon": "test" },
    { "pattern": "*.test.ts", "icon": "test" },
    { "pattern": "*.spec.ts", "icon": "test" }
  ],
  "fileRegex": [
    { "pattern": "^\\.env(\\..+)?$", "icon": "env" },
    { "pattern": "^\\.git(ignore|attributes|modules)$", "icon": "git" }
  ],
  "folderNames": {
    "src": "folder-src",
    "app": "folder-src",
    "tests": "folder-tests",
    "config": "folder-config",
    "public": "folder-public"
  },
  "folderNamesExpanded": {
    "src": "folder-src-open",
    "app": "folder-src-open",
    "tests": "folder-tests-open",
    "config": "folder-config-open",
    "public": "folder-public-open"
  },
  "symbols": {
    "namespace": "sym-namespace",
    "class": "sym-class",
    "abstractClass": "sym-abstract-class",
    "interface": "sym-interface",
    "trait": "sym-trait",
    "enum": "sym-enum",
    "method": "sym-method",
    "function": "sym-function",
    "property": "sym-property",
    "constant": "sym-constant",
    "marker.static": "marker-static"
  },
  "ui": {
    "toolwindow.project": "ui-project",
    "toolwindow.structure": "ui-structure",
    "toolwindow.commit": "ui-commit",
    "toolwindow.terminal": "ui-terminal",
    "toolwindow.git": "ui-git",
    "toolwindow.problems": "ui-problems",
    "toolwindow.run": "ui-run",
    "toolwindow.debug": "ui-debug",
    "action.run": "ui-run",
    "action.debug": "ui-debug",
    "action.stop": "ui-stop",
    "runconfig.php": "runconfig-php",
    "vcs.modified": "vcs-modified",
    "vcs.added": "vcs-added",
    "vcs.deleted": "vcs-deleted",
    "vcs.untracked": "vcs-untracked"
  },
  "options": {
    "treeArrows": "triangle",
    "iconSize": 16
  }
}
