    "scss": "css",
    "html": "html",
    "yml": "yaml",
    "yaml": "yaml",
    "lock": "lock"
  },
  "filePatterns": [
    { "pattern": "*Test.php", "icon": "test" },
    { "pattern": "*.test.ts", "icon": "test" },
    { "pattern": "*.spec.ts", "icon": "test" }
  ],
  "fileRegex": [
    { "pattern": "^\\.env(\\..+)?$", "icon": "env" },
    { "pattern": "^\\.git(ignore|attributes|modules)$", "icon": "git" }
  ],
  "folderNames": {
    "src": "folder-src",
    "app": "folder-src",
    "tests": "folder-tests",
    "config": "folder-config",
    "public": "folder-public"
  },
  "folderNamesExpanded": {
    "src": "folder-src-open",
    "app": "folder-src-open",
    "tests": "folder-tests-open",
    "config": "folder-config-open",
    "public": "folder-public-open"
  },
  "options": {
    "treeArrows": "triangle",
    "iconSize": 16
  }
