    "composer.json": "composer",
    "composer.lock": "lock",
    "package-lock.json": "lock",
    "pnpm-lock.yaml": "lock"
  },
  "fileExtensions": {
    "php": "php",
    "blade.php": "blade",
    "js": "js",
    "mjs": "js",
    "ts": "ts",
    "json": "json",
    "md": "markdown",
