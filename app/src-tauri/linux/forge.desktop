[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Integrated Development Environment
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
Categories=Development;IDE;TextEditor;
Keywords=PHP;Laravel;Symfony;JavaScript;TypeScript;Lua;editor;code;
MimeType=text/plain;text/markdown;text/x-log;text/csv;text/tab-separated-values;text/x-rst;application/json;application/x-yaml;application/yaml;application/toml;application/xml;text/xml;text/css;text/x-scss;text/x-sass;text/x-less;text/javascript;application/javascript;application/typescript;text/x-typescript;application/x-php;text/x-php;text/x-lua;text/x-python;text/x-python3;application/x-ruby;text/x-go;text/rust;text/x-java;text/x-kotlin;text/x-scala;text/x-groovy;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-csharp;text/x-swift;application/x-shellscript;text/x-sql;application/sql;text/x-makefile;text/x-dockerfile;application/x-desktop;inode/directory;
StartupWMClass=forge
StartupNotify=true
