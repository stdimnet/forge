{
  "name": "@forge/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n-check.mjs",
    "zindex:check": "node scripts/zindex-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:llms": "node ../../docs/scripts/build-llms.mjs",
    "plugin": "node ../../sdk/scripts/forge-plugin.mjs",
    "tauri": "node scripts/tauri.mjs",
    "wasm": "node scripts/build-wasm.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "workflows:check": "node scripts/release-tools.mjs workflows",
    "packaging:update": "node scripts/release-tools.mjs packaging",
    "packaging:srcinfo": "node scripts/release-tools.mjs srcinfo",
    "flatpak": "sh ../../packaging/flatpak/build.sh",
    "agents": "node scripts/build-agents.mjs",
    "langservers": "cargo run -q -p forge-langservers --bin forge-langservers --",
    "release": "node scripts/build-agents.mjs && node scripts/tauri.mjs build --config src-tauri/tauri.agents.conf.json",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "a11y:keyboard": "node scripts/a11y-keyboard.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-solid": "^1.59.0",
    "mermaid": "^11.17.2",
    "solid-js": "^1.9.0",
    "y-codemirror.next": "~0.3.6",
    "y-protocols": "~1.0.7",
    "yjs": "~13.6.33"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.0.0"
  }
}
